# Leave DATABASE_URL empty to use the embedded local database (.data/pglite).
# For Supabase or any Postgres, paste its connection string.
DATABASE_URL=

# Admin login (single account). Change before deploying.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
SESSION_SECRET=dev-only-secret-change-me-please-32chars

# Where enquiry emails go (sending is wired up later with Resend).
ENQUIRY_EMAIL=enquiries@example.com

# Enquiry emails through Resend. Without RESEND_API_KEY enquiries are still saved, just not emailed.
RESEND_API_KEY=
# Must be a sender on a domain verified in Resend. The default only delivers to your own Resend account email.
EMAIL_FROM=
